import java.lang.management.PlatformLoggingMXBean;
import java.util.Scanner;
import java.util.Random;

public class GameSetting {

    // show me all commands
    public void possibleGameCommands() {
        System.out.println("Possible commands: ");

        for (Command c : Command.values()) {
            System.out.println(c + ": " + c.getDescription());
        }
        System.out.println();
    }

    public void possibleFightCommands() {
        System.out.println("These are all possible commands during the fight: ");

        for (FightActions f : FightActions.values()) {
            System.out.println(f + ": " + f.getDescription());
        }
        System.out.println();
    }

    // show me all roles to play
    public void roleToPlay() {
        System.out.println("Possible roles: ");

        for (RoleToPlay r : RoleToPlay.values()) {
            System.out.println(r + ": " + r.getDescription());
        }
        System.out.println();
    }

    // validate the name nad the role of a player and return name and role
    public static String[] validatePlayer(Scanner scanner, int playerNumber, String previousPlayerName) {
        System.out.println("Enter player name: ");
        String playerName = scanner.nextLine();
        playerName = playerName.isEmpty() ? "player" + playerNumber : playerName;

        if (playerNumber == 2) {
            while (playerName.toLowerCase().trim() .equals(previousPlayerName.trim().toLowerCase())) {
                System.out.println("Same name for both players is confusing. Player 2, please enter new name:");
                playerName = scanner.nextLine();
                playerName = playerName.isEmpty() ? "player" + playerNumber : playerName;
            }
        }

        String playerRole = "";
        boolean isValidRole = false;

        while (! isValidRole) {
            System.out.println("Select role for player " + playerName + " (mage, druid, warrior): ");
            playerRole = scanner.nextLine().toUpperCase().trim();

            try {
                RoleToPlay action = RoleToPlay.valueOf(playerRole);
                playerRole = action.name().toLowerCase();
                isValidRole = true;
            } catch (IllegalArgumentException e) {
                System.out.println("Invalid input. Select role for player " + playerName + " (mage, druid, warrior): ");
            }
        }

        return new String[]{playerName, playerRole};
    }

    public void showPlayerStats(Character playerOne) {
        System.out.println("Player " + playerOne.getName() + " (" + playerOne.getRole() + ") stats:");
        System.out.println("Health: " + playerOne.getHealth());
        System.out.println("Close attack: " + playerOne.getCloseAttack());
        System.out.println("Range attack: " + playerOne.getRangeAttack());
        System.out.println("Move: " + playerOne.getMove());
        System.out.println("Special ability: " + playerOne.getSpecialAbility());
        System.out.println("Special ability cooldown: " + playerOne.getCooldownSpecialAbility() + " rounds");
        System.out.println();
    }

    public void showStats(Character playerOne, Character playerTwo, int startingDistanceBetweenPLayers) {
        showPlayerStats(playerOne);
        showPlayerStats(playerTwo);
        System.out.println("Current distance between players: " + startingDistanceBetweenPLayers + "\n");
        }

    public int whoStarts(Character playerOne, Character playerTwo) {
        Random random = new Random();

        if (playerOne.getSpeed() > playerTwo.getSpeed()) {
            return 1;
        } else if (playerOne.getSpeed() < playerTwo.getSpeed()) {
            return 2;
        } else {
            return random.nextInt(1, 3);
        }
    }

    public String playerMakeAnAction(int round, Scanner scanner, Character playerOne, Character playerTwo) {
        String name = (round % 2 == 0) ? playerTwo.getName() : playerOne.getName();
        System.out.println(name + ", choose your action:");
        String inputFight = scanner.nextLine().trim().toUpperCase();
        return inputFight;
    }

    public boolean giveUp(int round, Character playerOne, Character playerTwo) {
        if (round % 2 == 0) {
            System.out.println("Player " + playerTwo.getName() + " gave up! The winner is " + playerOne.getName());
        } else {
            System.out.println("Player " + playerOne.getName() + " gave up! The winner is " + playerTwo.getName());
        }
        System.out.println("The fight is over!\n");
        possibleGameCommands();
        return false;
    }

    public Character updatePlayerStats(Character player, int newHealthValue) {
        player.setHealth(newHealthValue);
        return player;
    }

    public int updateDistanceForward(int distance, Character player) {
        if (distance == 0) {
            System.out.println("You cannot get closer. Distance is already 0.");
            return distance;
        }
        distance = distance - player.getMove();
        if (distance < 0) {
            distance = 0;
        }
        System.out.println(player.getName() + " moved towards the enemy. New distance between them is " + distance + ".");
        return distance;
    }

    public int updateDistanceAway(int distance, Character player) {
        distance = distance + player.getMove();
        if (distance >  20) {
            System.out.println("You cannot get further. Distance is 20 and it is max distance.");
            distance = 20;
            return distance;
        }
        System.out.println(player.getName() + " moved away from his enemy. New distance between them is " + distance + ".");
        return distance;
    }

    public Character whoIsActive(int round, Character playerOne, Character playerTwo) {
        if (round % 2 == 0) {
            return playerTwo;
        } else {
            return playerOne;
        }
    }

    public Character attackOnYourEnemy(Character attackingPlayer, Character targetPlayer, String attackStyle) {
        int newHealthValue;
        if (attackStyle.toLowerCase().trim().equals("attack")) {
            newHealthValue = targetPlayer.getHealth() - attackingPlayer.getCloseAttack();
        } else {
            newHealthValue = targetPlayer.getHealth() - attackingPlayer.getRangeAttack();
        }
        if (newHealthValue <= 0) {
            System.out.println(targetPlayer.getName() + " was hit. No HP left!");
            System.out.println("*** The fight is over. The winner is " + attackingPlayer.getName() + ". His opponent " + targetPlayer.getName() + " was defeated! ***\n");
            System.out.println("New game ?");
        } else {
            System.out.println(targetPlayer.getName() + " was hit. HP left: " + newHealthValue);
        }
        targetPlayer.setHealth(newHealthValue);
        return targetPlayer;
    }

    public boolean isHeDead(int hpNumber) {
        if (hpNumber <= 0) {
            possibleGameCommands();
            return false;
        } else {
            return true;
        }
    }

    public boolean passivityCheck(int passiveRoundNumber) {
        if (passiveRoundNumber >= 8 && passiveRoundNumber < 12) {
            System.out.println("WARNING. There was no fight for " + passiveRoundNumber + " rounds!");
            System.out.println("If the number raises to 12, the fight will be over.");
            return true;
        } else if (passiveRoundNumber >= 12) {
            System.out.println("The fight is over due the passivity of both players!!\n");
            possibleGameCommands();
            return false;
        } else {
            return true;
        }
    }

    public int cooldownSet(Character player) {
        int newValue;
        if (player.getCooldownSpecialAbility() > 0) {
            newValue = player.getCooldownSpecialAbility() - 1;
        } else {
            newValue = 0;
        }
        return newValue;
    }

    public void specialActionExecution(Character activePlayer) {
        System.out.println(activePlayer.getName() + (" (") + activePlayer.getRole() + ") used his special move!" );
        if (activePlayer.getRole().equals("mage")) {
            System.out.println("Opponent is shifted and cannot do any action next turn !");
        } else if (activePlayer.getRole().equals("druid")) {
            System.out.println("You healed yourself for 30hp !");
        } else {
            System.out.println("You charged your enemy.");
        }
    }
}
