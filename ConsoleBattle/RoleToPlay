public enum RoleToPlay {
    MAGE("can cause the highest damage in range combat and also can stun his opponent. But is very vulnerable in close combat and does not have high health.", 80, 5, 35, 2, 3),
    DRUID("decent damage in range and close combat. Can heal himself. The fastest role with average health.", 100, 25, 20, 3, 3),
    WARRIOR("can cause the highest damage in close combat and also can charge his opponent. Highest health, but quite slow.", 120, 35, 5, 1, 3);

    private final String description;
    private final int health;
    private final int closeAttack;
    private final int rangeAttack;
    private final int speed;
    private final int move;

    RoleToPlay(String description, int health, int closeAttack, int rangeAttack, int speed, int move) {
        this.description = description;
        this.health = health;
        this.closeAttack = closeAttack;
        this.rangeAttack = rangeAttack;
        this.speed = speed;
        this.move = move;
    }

    public String getDescription() {
        return description;
    }

    public Character createCharacter(String name) {
        return switch (this) {
            case MAGE -> new Mage(name, this.name().toLowerCase(), health, closeAttack, rangeAttack, speed, move);
            case DRUID -> new Druid(name, this.name().toLowerCase(), health, closeAttack, rangeAttack, speed, move);
            case WARRIOR -> new Warrior(name, this.name().toLowerCase(), health, closeAttack, rangeAttack, speed, move);
        };
    }
}
