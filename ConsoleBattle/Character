public class Character {

    private String name;
    private String role;
    private int health;
    private int closeAttack;
    private int rangeAttack;
    private int speed;
    private int move;
    private String specialAbility;
    private int cooldownSpecialAbility;

    // konstruktor
    public Character(String name, String role, int health, int closeAttack, int rangeAttack, int speed, int move, String specialAbility) {
        this.name = name;
        this.role = role;
        this.health = health;
        this.closeAttack = closeAttack;
        this.rangeAttack = rangeAttack;
        this.speed = speed;
        this.move = move;
        this.specialAbility = specialAbility;
        this.cooldownSpecialAbility = 0;

    }

    public void shout() {
        System.out.println("jsem obecna postava");
    }

    public String getName() {
        return name;
    }
    public String getRole() {
        return role;
    }
    public int getHealth() {
        return health;
    }
    public int getCloseAttack() {
        return closeAttack;
    }
    public int getRangeAttack() {
        return rangeAttack;
    }
    public int getSpeed() {
        return speed;
    }
    public int getMove() {
        return move;
    }

    public String getSpecialAbility() {
        return specialAbility;
    }

    public int getCooldownSpecialAbility() {
        return cooldownSpecialAbility;
    }

    public void setHealth(int health) {
        this.health = health;
    }
}
