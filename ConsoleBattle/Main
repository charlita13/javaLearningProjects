import java.util.ArrayList;
import java.util.List;
import java.util.Scanner;

public class Main {
    public static void main(String[] args) {

        // hlavní parametry
        Scanner scanner = new Scanner(System.in);
        GameSetting game = new GameSetting();
        boolean letsChoose = true;

        // uvítání a úvodní informace
        System.out.println("""
        ================================
          WELCOME TO BATTLE SIMULATOR
        ================================
        """);

        game.possibleGameCommands();

        // hlavní cyklus
        while (letsChoose) {
            System.out.println("Choose your action:");
            String input = scanner.nextLine().trim().toUpperCase();

            // hlavní přepínač pro pokyny
            try {
                Command action = Command.valueOf(input);

                switch (action) {
                    // hlavní hra
                    case PLAY -> {
                        boolean letsPlay = true;
                        int round = 0;
                        int startingDistanceBetweenPLayers = 5;
                        int passivityCheck = 1;

                        // založení listu v kterém jsou uloženi hráči
                        List<Character> players = new ArrayList<>();

                        // založení hráčů - získám roli a jméno
                        String[] playerValues = new String[0];

                        for (int i = 1; i <= 2; i++) {
                            System.out.println("Player " + i + " setting: ");
                            if (i == 1) {
                                playerValues = GameSetting.validatePlayer(scanner, i, "");
                            } else {
                                playerValues = GameSetting.validatePlayer(scanner, i, players.get(0).getName());
                            }
                            RoleToPlay role = RoleToPlay.valueOf(playerValues[1].toUpperCase());

                            // založím postavu se všemi staty
                            Character player = role.createCharacter(playerValues[0]);
                            players.add(player);
                        }

                        // vypíšu možné povely pro boj
                        game.showStats(players.get(0), players.get(1), startingDistanceBetweenPLayers);
                        game.possibleFightCommands();

                        System.out.println("Lets the fight begin !\n");
                        System.out.printf("*** %s VS %s ***\n\n", players.get(0).getName(), players.get(1).getName());

                        // hlavní cyklus pro boj
                        while (letsPlay) {

                            // kdo má první tah
                            if (round == 0) {
                                round = game.whoStarts(players.get(0), players.get(1));
                            }

                            Character activePlayer = game.whoIsActive(round, players.get(0), players.get(1));
                            Character passivePlayer = activePlayer.equals(players.get(0)) ? players.get(1) : players.get(0);

                            // zadání povelu od hráče
                            String inputFight = game.playerMakeAnAction(round, scanner, players.get(0), players.get(1));

                            // kontrola pasivity
                            letsPlay = game.passivityCheck(passivityCheck);

                            // hlavní přepínač pro pokyny
                            try {
                                FightActions actionFight = FightActions.valueOf(inputFight);

                                switch (actionFight) {
                                    case FORWARD -> {
                                        startingDistanceBetweenPLayers = game.updateDistanceForward(startingDistanceBetweenPLayers, activePlayer);
                                        activePlayer.setCooldownSpecialAbility(game.cooldownSet(activePlayer));
                                        round++;
                                        passivityCheck++;
                                    }
                                    case AWAY -> {
                                        startingDistanceBetweenPLayers = game.updateDistanceAway(startingDistanceBetweenPLayers, activePlayer);
                                        activePlayer.setCooldownSpecialAbility(game.cooldownSet(activePlayer));
                                        round++;
                                        passivityCheck++;
                                    }
                                    case SHOOT -> {
                                        if (startingDistanceBetweenPLayers < 3) {
                                            System.out.println("You are too close to your opponent. Get closer to shoot.\n(min distance to shoot is 3 and your current distance is " + startingDistanceBetweenPLayers + ")");
                                            passivityCheck++;
                                        } else if (startingDistanceBetweenPLayers > 10) {
                                            System.out.println("You are too far from your opponent. Get closer to shoot.\n(max distance to shoot is 10 and your current distance is " + startingDistanceBetweenPLayers + ")");
                                            passivityCheck++;
                                        } else {
                                            passivityCheck = 0;
                                            game.attackOnYourEnemy(activePlayer, passivePlayer, inputFight);
                                            letsPlay = game.isHeDead(passivePlayer.getHealth());
                                            }
                                        activePlayer.setCooldownSpecialAbility(game.cooldownSet(activePlayer));
                                        round++;
                                        }
                                    case ATTACK -> {
                                        if (startingDistanceBetweenPLayers > 1) {
                                            passivityCheck++;
                                            System.out.println("You are too far from your opponent. Get closer to attack.\n(distance to fight in close combat has to be 0 or 1, your current distance is " + startingDistanceBetweenPLayers + ")");
                                        } else {
                                            passivityCheck = 0;
                                            game.attackOnYourEnemy(activePlayer, passivePlayer, inputFight);
                                            letsPlay = game.isHeDead(passivePlayer.getHealth());
                                        }
                                        activePlayer.setCooldownSpecialAbility(game.cooldownSet(activePlayer));
                                        round++;
                                    }
                                    case SPECIAL -> {
                                        if (activePlayer.getCooldownSpecialAbility() == 0) {
                                            if (activePlayer.getRole().equals("druid")) {
                                                activePlayer = game.specialActionDruid(activePlayer);
                                                activePlayer.setCooldownSpecialAbility(3);
                                            } else if (activePlayer.getRole().equals("mage")) {
                                                round = game.specialActionMage(activePlayer, round);
                                                activePlayer.setCooldownSpecialAbility(3);
                                            }  else {
                                                startingDistanceBetweenPLayers = game.specialActionWarrior(activePlayer, startingDistanceBetweenPLayers);
                                                activePlayer.setCooldownSpecialAbility(3);
                                            }
                                        } else {
                                            System.out.println("Spell is not ready yet. (CD remaining " + (activePlayer.getCooldownSpecialAbility()) + ")");
                                            activePlayer.setCooldownSpecialAbility(game.cooldownSet(activePlayer));
                                        }
                                        round++;
                                    }
                                    case GIVEUP -> letsPlay = game.giveUp(round, players.get(0), players.get(1));
                                    case STATS -> {
                                        game.showStats(players.get(0), players.get(1), startingDistanceBetweenPLayers);
                                    }
                                    case HELP -> game.possibleFightCommands();
                                }
                            } catch (IllegalArgumentException e) {
                                System.out.println("Invalid input, try again.");
                            }
                        }
                    }
                    case ROLE -> game.roleToPlay();
                    case HELP -> game.possibleGameCommands();
                    case EXIT -> {
                        System.out.println("Exiting game...");
                        letsChoose = false;

                    }
                }
            } catch (IllegalArgumentException e) {
                System.out.println("Invalid input, try again.");
            }
        }
    }
}
