import java.util.List;

public class Character {

    private int hp;
    private int defense;
    private int attack;
    private int speed;
    private int potionNumber;
    private int shield;
    private int sword;
    private List<String> bag;

    public Character() {
        this.speed = 3;
        this.hp = 50;
        this.attack = 20;
        this.defense = 10;
        this.potionNumber = 1;
        this.shield = 0;
        this.sword = 0;
    }

    public int getSpeed() {
        return speed;
    }

    public void setSpeed(int speed) {
        this.speed = speed;
    }

    public int getHp() {
        return hp;
    }

    public void setHp(int hp) {
        this.hp = hp;
    }

    public int getDefense() {
        return defense;
    }

    public void setDefense(int defense) {
        this.defense = defense;
    }

    public int getAttack() {
        return attack;
    }

    public void setAttack(int attack) {
        this.attack = attack;
    }

    public int getPotionNumber() {
        return potionNumber;
    }

    public void setPotionNumber(int potionNumber) {
        this.potionNumber = potionNumber;
    }


    public void setShield(int shield) {
        this.shield = shield;
    }

    public int getShield() {
        return shield;
    }

    public void setSword(int sword) {
        this.sword = sword;
    }

    public int getSword() {
        return sword;
    }

    public void showCharStats() {
        System.out.println("Speed: " + this.getSpeed());
        System.out.println("Health: " + this.getHp());
        System.out.println("Attack: " + this.getAttack());
        System.out.println("Defense: " + this.getDefense());
        System.out.println("Number of potions: " + this.getPotionNumber());
        System.out.println("Number of shields: " + this.getShield());
        System.out.println("Number of swords: " + this.getSword());
        System.out.println();
    }
}
