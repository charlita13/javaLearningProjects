import java.io.Serializable;

public class GameField implements Serializable {

    private static final long serialVersionUID = 1L;
    private final int row = 5;
    private final int column = 5;
    private String[][] field;

    public GameField() {
        field = new String[row][column];
        initializeField();
    }

    // vytvoaře herní pole
    public void initializeField() {
        for (int i = 0; i < row; i++) {
            for (int j = 0; j < column; j++) {
                field[i][j] = "?";
            }
        }
    }

    // vykresli herní pole
    public void printField() {
        for (int i = 0; i < row; i++) {
            for (int j = 0; j < column; j++) {
                System.out.print(field[i][j]);
            }
            System.out.println();
        }
    }

    // aktualizuj herní pole
    public void updateField(int rowIndex, int columnIndex, String symbol) {
        field[rowIndex][columnIndex] = symbol;
    }

    // pozice X (hráče)
    public int[] whereIsPlayer() {
        for (int i = 0; i < row; i++) {
            for (int j = 0; j < column; j++) {
                if ("▣".equals(field[i][j])) {
                    return new int[]{i, j};
                }
            }
        }
        return null;
    }

    // NSEW
    public boolean NSEW(String direction) {
        int[] playerposition = whereIsPlayer();
        int rowIndex = playerposition[0];
        int columnIndex = playerposition[1];

        if ("w".equals(direction.toLowerCase())) {
            columnIndex--;
        } else if ("e".equals(direction.toLowerCase())) {
            columnIndex++;
        } else if ("s".equals(direction.toLowerCase())) {
            rowIndex++;
        } else {
            rowIndex--;
        }

        if (rowIndex >= 0 && rowIndex < row && columnIndex >= 0 && columnIndex < column) {
            updateField(playerposition[0], playerposition[1], "■");
            updateField(rowIndex, columnIndex, "▣");
            return true;
        } else {
            System.out.println("Invalid coordinates! Out of bounds. Player did not move.");
            return false;
        }
    }

    public String[][] getField() {
        return field;
    }

    public boolean wasIAlreadyThere(String direction) {
        int[] playerposition = whereIsPlayer();
        int rowIndex = playerposition[0];
        int columnIndex = playerposition[1];

        if ("w".equals(direction.toLowerCase())) {
            columnIndex--;
        } else if ("e".equals(direction.toLowerCase())) {
            columnIndex++;
        } else if ("s".equals(direction.toLowerCase())) {
            rowIndex++;
        } else {
            rowIndex--;
        }

        if (rowIndex >= 0 && rowIndex < row && columnIndex >= 0 && columnIndex < column) {
            if ("■".equals(field[rowIndex][columnIndex])) {
                return true;
            } else {
                return false;
            }
        } else {
            return false;
        }
    }
}
