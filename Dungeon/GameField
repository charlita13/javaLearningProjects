import java.io.Serializable;

public class GameField implements Serializable {

    private static final long serialVersionUID = 1L;
    private final int row = 5;
    private final int column = 5;
    private String[][] field;

    public GameField() {
        field = new String[row][column];
        initializeField();
    }

    // vytvoaře herní pole
    public void initializeField() {
        for (int i = 0; i < row; i++) {
            for (int j = 0; j < column; j++) {
                field[i][j] = "■";
            }
        }
    }

    // vykresli herní pole
    public void printField() {
        for (int i = 0; i < row; i++) {
            for (int j = 0; j < column; j++) {
                System.out.print(field[i][j]);
            }
            System.out.println();
        }
    }

    // aktualizuj herní pole
    public void updateField(int rowIndex, int columnIndex, String symbol) {
        if (rowIndex >= 0 && rowIndex < row && columnIndex >= 0 && columnIndex < column) {
            field[rowIndex][columnIndex] = symbol;
        } else {
            System.out.println("Invalid coordinates! Out of bounds.");
        }
    }

    public String[][] getField() {
        return field;
    }
}
