import java.io.IOException;
import java.util.Scanner;

public class Main {
    public static void main(String[] args) {

        // hlavní nastavení
        Scanner scanner = new Scanner(System.in);
        GameBrain brain = new GameBrain();
        boolean mainMenuSwitch = true;

        // úvodní informace
        System.out.println("\n*** Welcome to Text Adventure RPG ***\n");
        brain.possibleMenuCommands();

        // HLAVNI MENU
        while (mainMenuSwitch) {

            // dotaz na volbu v menu
            System.out.println("\nChoose your action: ");
            String menuChoice = scanner.nextLine().toUpperCase().trim();

            // přepínač na orientaci v menu
            try {
                MenuCommand menuAction = MenuCommand.valueOf(menuChoice);

                switch (menuAction) {
                    case NEW -> {
                        Character character = new Character();
                        GameField gameField = new GameField();
                        System.out.println("Welcome to the dungeon. Here is a list of possible commands.");
                        brain.possibleGameCommands();
                        System.out.println("Survive as long as possible !");
                        System.out.println("Your postion on the map = ▣");

                        boolean gameSwitch = true;
                        gameField.updateField(0,0,"▣");
                        gameField.printField();

                        while (gameSwitch) {

                            // dotaz na volbu ve hře
                            System.out.println("\nChoose your action: ");
                            String gameChoice = scanner.nextLine().toUpperCase().trim();

                            // přepínač na orientaci v menu
                            try {
                                GameCommand gameAction = GameCommand.valueOf(gameChoice);

                                switch (gameAction) {
                                    case N, S, E, W -> {
                                        gameField.NSEW(gameChoice);
                                        gameField.printField();
                                    }
                                    case MAP -> {
                                        System.out.println("MAP");
                                    }
                                    case STATS -> {
                                        System.out.println("Current stats of the player:");
                                        character.showCharStats();
                                    }
                                    case BAG -> {System.out.println("BAG");}     // Todo
                                    case POTION -> {System.out.println("POTION");}     // Todo
                                    case ARMOR -> {System.out.println("ARMOR");}     // Todo
                                    case WEAPON -> {System.out.println("WEAPON");}     // Todo
                                    case SAVE -> {System.out.println("SAVE");}     // Todo
                                    case HELP -> {
                                        brain.possibleGameCommands();
                                    }
                                    case LEAVE -> {System.out.println("LEAVE");}     // Todo
                                    case EXIT -> {     // Todo
                                        System.out.println("Game closed without saving. Bye");
                                        gameSwitch = false;
                                        mainMenuSwitch = false;
                                        }
                                    }
                            } catch (IllegalArgumentException e) {
                                System.out.println("Invalid input. Enter again your command.");
                            }
                        }
                    }
                    case LOAD -> {
                        System.out.println("LOAD");     // Todo
                    }
                    case ABOUT -> {
                        brain.describeGame();
                    }
                    case HELP -> {
                        brain.possibleMenuCommands();
                    }
                    case EXIT -> {
                        System.out.println("Goodbye!");
                        mainMenuSwitch = false;
                    }
                }
            } catch (IllegalArgumentException e) {
                System.out.println("Invalid input. Enter again your command.");
            }
        }
        scanner.close();
    }
}
