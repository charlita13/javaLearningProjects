import java.io.IOException;
import java.util.Scanner;
import java.util.Random;


public class Main {
    public static void main(String[] args) {

        // hlavní nastavení
        Scanner scanner = new Scanner(System.in);
        GameBrain brain = new GameBrain();
        boolean mainMenuSwitch = true;
        boolean moved;
        boolean alreadyThere;
        Item thisFieldAction;

        // úvodní informace
        System.out.println("\n*** Welcome to Text Adventure RPG ***\n");
        brain.possibleMenuCommands();

        // HLAVNI MENU
        while (mainMenuSwitch) {

            // dotaz na volbu v menu
            System.out.println("\nChoose your action: ");
            String menuChoice = scanner.nextLine().toUpperCase().trim();

            // přepínač na orientaci v menu
            try {
                MenuCommand menuAction = MenuCommand.valueOf(menuChoice);

                switch (menuAction) {
                    case NEW -> {
                        Character character = new Character();
                        GameField gameField = new GameField();
                        System.out.println("Welcome to the dungeon. Here is a list of possible commands.");
                        brain.possibleGameCommands();
                        System.out.println("Survive as long as possible !");
                        System.out.println("Your postion on the map = ▣");

                        boolean gameSwitch = true;
                        gameField.updateField(0,0,"▣");
                        gameField.printField();

                        while (gameSwitch) {

                            // dotaz na volbu ve hře
                            System.out.println("\nChoose your action: ");
                            String gameChoice = scanner.nextLine().toUpperCase().trim();

                            // přepínač na orientaci v menu
                            try {
                                GameCommand gameAction = GameCommand.valueOf(gameChoice);

                                switch (gameAction) {
                                    case N, S, E, W -> {
                                        alreadyThere = gameField.wasIAlreadyThere(gameChoice);
                                        moved = gameField.NSEW(gameChoice);
                                        if (moved) {
                                            if (alreadyThere) {
                                                System.out.println("You have already been here.");
                                            } else {
                                                thisFieldAction = brain.whatIsThere();
                                                if (thisFieldAction.getName().equals("potion")) {
                                                    character.setPotionNumber(character.getPotionNumber() + 1);
                                                    System.out.println("You have " + character.getPotionNumber() + "potions.");
                                                } else if (thisFieldAction.getName().equals("weakShield")) {
                                                    character.setWeakShield(character.getWeakShield() + 1);
                                                } else if (thisFieldAction.getName().equals("strongShield")) {
                                                    character.setStrongShield(character.getStrongShield() + 1);
                                                } else if (thisFieldAction.getName().equals("weakSword")) {
                                                    character.setWeakSword(character.getWeakSword() + 1);
                                                } else if (thisFieldAction.getName().equals("strongSword")) {
                                                    character.setStrongSword(character.getStrongSword() + 1);
                                                }
                                                // ToDo - akce dle toho co objeví - weakEnemy, strongEnemy, boss
                                            }
                                        }
                                         gameField.printField();
                                    }
                                    case MAP -> {
                                        System.out.println("MAP");
                                    }
                                    case STATS -> {
                                        System.out.println("Current stats of the player:");
                                        character.showCharStats();
                                    }
                                    case POTION -> {
                                        if (character.getPotionNumber() > 0) {
                                            if (character.getHp() <= 50) {
                                                character.setHp(character.getHp() + 15);
                                                character.setPotionNumber(character.getPotionNumber() - 1);
                                                if (character.getHp() > 50) {
                                                    character.setHp(50);
                                                }
                                                System.out.println("You used a potion. Your hp is now " + character.getHp() + ". You have " + character.getPotionNumber() + " potions left.");
                                            }
                                            else {
                                                System.out.println("You have full health. You can't use a potion now.");
                                            }


                                        } else {
                                            System.out.println("You don't have any potions.");
                                        }
                                    }
                                    case ARMOR -> {System.out.println("ARMOR");}     // Todo
                                    case WEAPON -> {System.out.println("WEAPON");}     // Todo
                                    case SAVE -> {System.out.println("SAVE");}     // Todo
                                    case HELP -> {
                                        brain.possibleGameCommands();
                                    }
                                    case LEAVE -> {System.out.println("LEAVE");}     // Todo - save y or n
                                    case EXIT -> {     // Todo
                                        System.out.println("Game closed without saving. Bye");
                                        gameSwitch = false;
                                        mainMenuSwitch = false;
                                        }
                                    }
                            } catch (IllegalArgumentException e) {
                                System.out.println("Invalid input. Enter again your command.");
                            }
                        }
                    }
                    case LOAD -> {
                        System.out.println("LOAD");     // Todo
                    }
                    case ABOUT -> {
                        brain.describeGame();
                    }
                    case HELP -> {
                        brain.possibleMenuCommands();
                    }
                    case EXIT -> {
                        System.out.println("Goodbye!");
                        mainMenuSwitch = false;
                    }
                }
            } catch (IllegalArgumentException e) {
                System.out.println("Invalid input. Enter again your command.");
            }
        }
        scanner.close();
    }
}
