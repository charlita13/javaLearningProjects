import java.util.Scanner;
import java.util.Random;

public class GameBrain {

    // objekty k nalezení
    Item nothing = new Item("nothing", 0, 0, 0, 0, 0, 0);
    Item potion = new Item("potion", 1, 0, 0, 10, 0, 0);
    Item shield = new Item("shield", 5, 10, 0, 0, 0, 0);
    Item sword = new Item("sword",5, 0, 10, 0, 0, 0);
    Item boss = new Item("boss", 0, 20, 10, 0, 1, 100);
    Item weakEnemy = new Item("weakEnemy", 0, 5, 10, 0, 2, 30);
    Item strongEnemy = new Item("strongEnemy", 0, 10, 10, 0, 4, 50);

    // MenuCommands
    public void possibleMenuCommands() {
        System.out.println("Possible commands: ");
        for (MenuCommand c : MenuCommand.values()) {
            System.out.println("  -> " + c + " (" + c.getDescription() + ")");
        }
    }

    public void possibleGameCommands() {
        System.out.println("Possible game commands: ");
        for (GameCommand gc : GameCommand.values()) {
            System.out.println("  -> " + gc + " (" + gc.getDescription() + ")");
        }
    }

    public void describeGame() {
        System.out.println("Go through the dungeon and try to finish your task.");
        System.out.println("Survival mode - get as far as possible.");
        System.out.println("Task mode - finish your task.");
    }

    public boolean areYouSure(Scanner scanner) {
        System.out.println("Are you sure? Yes = 'Y' or type anything else for no.");
        String response =  scanner.nextLine();
        boolean resultResponse = (response.toLowerCase().equals("y")) ? true : false;
        return resultResponse;
    }

    public Item whatIsThere() {
        Random rand = new Random();
        int number = rand.nextInt(100) + 1; // 1 - 100
        if (number <= 20) {
            System.out.println("Nothing there.");
            return nothing;
        } else if (number <= 40) {
            System.out.println("You found a health potion. The potion added in your bag");
            return potion;
        } else if (number <= 50) {
            System.out.println("You found a shield.");
            return shield;
        } else if (number <= 60) {
            System.out.println("You found a sword.");
            return sword;
        } else if (number <= 80) {
            System.out.println("You found an enemy.");
            return weakEnemy;
        } else if (number <= 92) {
            System.out.println("You found an strong enemy.");
            return strongEnemy;
        } else {
            System.out.println("You found a boss.");
            return boss;
        }
    }

    public int shieldDefense() {
        return shield.getDefense();
    }
}
