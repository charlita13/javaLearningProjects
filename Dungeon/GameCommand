public enum GameCommand {
    N("Move to the north"),
    S("Move to the south"),
    E("Move to the east"),
    W("Move to the west"),
    MAP("Show map"),
    STATS("Show your stats"),
    POTION("Use potion from your bag to restore hp"),
    ARMOR("Use armor from your bag to upgrade defense"),
    WEAPON("Use weapon from your bag to upgrade attack"),
    SAVE("Save current game"),
    HELP("Show all possible commands"),
    LEAVE("Back to main menu?"),
    EXIT("Exit current game and the program");

    private final String description;

    GameCommand(String description) {
        this.description = description;
    }

    public String getDescription() {
        return description;
    }
}
