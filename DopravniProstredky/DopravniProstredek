package org.example;

public abstract class DopravniProstredek {
    private String znacka;
    private String model;
    private int rokVyroby;
    private int zakladniCena;

    DopravniProstredek(String znacka, String model, int rokVyroby, int zakladniCena) {
        this.znacka = znacka;
        this.model = model;
        this.rokVyroby = rokVyroby;
        this.zakladniCena = zakladniCena;
    }

    public int getRokVyroby() {
        return rokVyroby;
    }

    public int getZakladniCena() {
        return zakladniCena;
    }

    public String getModel() {
        return model;
    }

    public String getZnacka() {
        return znacka;
    }

    public abstract int vypisVyslednouCenu();

    public abstract void vypisVsechnyInformace();
}
